# Copy to telegram/.env on the Oracle VM. NEVER commit the real file.
BOT_DOMAIN=bot.example.com
BOT_IMAGE=ghcr.io/eplus-dev/muse-invite-hub-telegram:latest
TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRIVATE_BOTFATHER_TOKEN
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
# Fine-grained GitHub credential scoped ONLY to muse-invite-hub with Issues: Read & Write.
# Never use a user-wide classic token when a scoped credential suffices.
GITHUB_ISSUES_TOKEN=REPLACE_WITH_SCOPED_GITHUB_ISSUES_CREDENTIAL
